CONFIG_ARM=y
CONFIG_TARGET_MJ_BOARD=y
CONFIG_DEFAULT_DEVICE_TREE="mj"
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_SYS_NS16550_MEM32=y
CONFIG_TEXT_BASE=0x80000000
CONFIG_SYS_LOAD_ADDR=0x80000000
CONFIG_INIT_SP_RELATIVE=y
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x80000

# CPU display is optional until board-specific identification is implemented.
# CONFIG_DISPLAY_CPUINFO is not set

# Delegate reset to the PSCI service provided by TF-A.
CONFIG_SYSRESET=y
CONFIG_SYSRESET_PSCI=y

CONFIG_MMC=y
CONFIG_CMD_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_MJ=y

# Read the existing RAM-rootfs FIT from the SD card's FAT32 boot partition.
CONFIG_DOS_PARTITION=y
CONFIG_CMD_PART=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_FIT=y
CONFIG_CMD_BOOTM=y
CONFIG_HUSH_PARSER=y
CONFIG_ENV_SOURCE_FILE="mj"
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run bootsd"
