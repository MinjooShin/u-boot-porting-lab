/* The SD controller is mmc 0 in this U-Boot device tree. */
mmcdev=0
mmcpart=1
fit_addr_r=0x90000000
bootfile=image.itb

/* Keep the console and CMA settings used by the existing Linux image. */
bootargs=console=ttyS3,115200n8 earlycon loglevel=8 cma=512M rootwait

bootsd=
	mmc dev ${mmcdev} &&
	mmc rescan &&
	fatload mmc ${mmcdev}:${mmcpart} ${fit_addr_r} ${bootfile} &&
	bootm ${fit_addr_r}
